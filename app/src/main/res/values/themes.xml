<resources>
    <style name="Theme.MoneyTracker" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <!-- Lembar "Catat cepat" dari widget: transparan agar wallpaper tetap terlihat di belakangnya. -->
    <style name="Theme.MoneyTracker.QuickAdd" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="bg">#FF0B0F1A</color>
    <color name="brand">#FF7C5CFF</color>
</resources>
