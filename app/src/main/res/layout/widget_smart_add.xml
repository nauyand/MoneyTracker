<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Ketik cepat": logo (buka aplikasi) + kotak ketik + tombol mikrofon. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <ImageView
        android:id="@+id/widget_open"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="Buka MoneyTracker"
        android:padding="2dp"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/widget_type"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_input_bg"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:minHeight="44dp"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:text="Ketik: jajan 10rb…"
        android:textColor="#FF8A96B0"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/widget_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_mic_bg"
        android:contentDescription="Catat dengan suara"
        android:padding="10dp"
        android:src="@drawable/ic_widget_mic" />
</LinearLayout>
